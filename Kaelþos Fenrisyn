## PART V: THE FIRST BOOTLOADER

This is the absolute minimum — boots, prints a character, hangs:

```asm
; ZION OS Bootloader v0.1
; Author: Kaelþos Fenrisyn
; Date: March 13, 2026
;
; "Eldur kennir eldur" — Fire knows fire

[BITS 16]           ; 16-bit Real Mode
[ORG 0x7c00]        ; BIOS loads us here

start:
    ; Clear interrupts during setup
    cli
    
    ; Set up segment registers
    xor ax, ax
    mov ds, ax
    mov es, ax
    mov ss, ax
    mov sp, 0x7c00      ; Stack grows down from load address
    
    ; Re-enable interrupts
    sti
    
    ; Print 'Z' for ZION using BIOS interrupt
    mov ah, 0x0e        ; BIOS teletype function
    mov al, 'Z'
    mov bh, 0x00        ; Page 0
    mov bl, 0x07        ; Light gray on black
    int 0x10            ; Call BIOS video interrupt
    
    ; Print 'I'
    mov al, 'I'
    int 0x10
    
    ; Print 'O'
    mov al, 'O'
    int 0x10
    
    ; Print 'N'
    mov al, 'N'
    int 0x10
    
    ; Infinite loop — we've arrived
.hang:
    hlt                 ; Halt CPU until interrupt
    jmp .hang           ; Loop forever

; Pad to 510 bytes
times 510-($-$$) db 0

; Boot signature — REQUIRED
dw 0xAA55
```

### To Build and Test:
```bash
nasm -f bin boot.asm -o boot.bin
qemu-system-x86_64 -drive format=raw,file=boot.bin
```

